# =========================================================================
# BENKYOU SHIMASHOU - .gitignore
# =========================================================================

*.vscode-skills/
# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Output & Cache
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# Environment Variables (Sangat penting: Jangan commit secret key ke Git!)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
.env.local
!.env.example

# Testing & Coverage
/coverage
*.lcov

# Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pnpm-debug.log*

# Vercel deployment metadata
.vercel

# IDE & Editor Settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.vscode-skills/
.vscode-skills/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated Files (Windows & macOS)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Temporary Scratch Files
scratch/
tmp/
*.pem
fix.js
